# Copie para .env e preencha com os dados do seu projeto Supabase
# (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# Notificações push (opcional — "seu pedido saiu para entrega" no PWA):
# gere o par com: npx web-push generate-vapid-keys --json
# pública aqui; privada vira SECRET da Edge Function no Supabase:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:contato@sualoja.com
VITE_VAPID_PUBLIC_KEY=

# Pix online (Mercado Pago): as credenciais NÃO vão aqui — ficam como secrets
# das Edge Functions (supabase secrets set MP_ACCESS_TOKEN=... etc.).
# Ver README > "Pix automático (Mercado Pago)".
