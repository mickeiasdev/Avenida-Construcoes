# Copie para .env e preencha com os dados do seu projeto Supabase
# (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# Pix online (AbacatePay): as credenciais NÃO vão aqui — ficam como secrets
# das Edge Functions (supabase secrets set ABACATE_API_KEY=... etc.).
# Ver README > "Pix automático (AbacatePay)".
