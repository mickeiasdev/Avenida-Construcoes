# Copie para .env e preencha com os dados do seu projeto Supabase
# (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# Mercado Pago (Orders API - Pix QR + Copia e Cola)
# Public Key vai no front (VITE_); Access Token fica SÓ na Edge Function como secret
# Supabase Dashboard > Edge Functions > Secrets > MP_ACCESS_TOKEN
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
