{
  "rewrites": [
    {
      "source": "/produto/:id",
      "destination": "/api/produto-seo"
    },
    {
      "source": "/c/:slug",
      "destination": "/api/c-seo"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}